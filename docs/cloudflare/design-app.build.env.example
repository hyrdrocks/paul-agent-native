# Build-time environment for hyrdrocks/paul-design-app.
#
# The Cloudflare Worker preset GENERATES .output/server/wrangler.json. These
# variables are the only way three of the five bindings get into it; the queue
# and the BROWSER binding are emitted from the Worker's name and need nothing
# here.
#
# Values are real and provisioned (see design-app-resources.md). A database id
# is an identifier, not a credential. No secret belongs in this file — the
# provider key and the auth secrets are set with `wrangler secret put` for the
# deploy and in `.cf-local/dev.vars` for the local Workers run.

NITRO_PRESET=cloudflare_module

# Both, or neither. resolveCloudflareD1Binding() throws on exactly one, and
# returns null on neither — which silently means "use DATABASE_URL" and leaves
# the Worker on the SQLite path.
CLOUDFLARE_D1_DATABASE_NAME=paul-design-app
CLOUDFLARE_D1_DATABASE_ID=256288ec-77ac-4e9d-ab1b-8d415e4ee997

# Omitting this is not an error at build or deploy time: the UPLOADS binding is
# simply not emitted and the first upload fails closed at runtime. The local
# `just cf` build needs it too, or local and deployed take different paths.
CLOUDFLARE_R2_BUCKET_NAME=paul-design-app-uploads
